# ── Variables
set $mod Mod4
set $terminal "WINIT_X11_SCALE_FACTOR=2 alacritty"
set $termexec "~/terminal-i3-exec.sh"
set $browser brave
set $menu rofi -show drun
set $cursor Breeze_Snow
set $fileManager "WINIT_X11_SCALE_FACTOR=2 alacritty -e ranger" 
set $guiFileManager nautilus

font pango:JetBrains Mono 10

# ── keybindings: power
bindsym $mod+Shift+r reload
bindsym $mod+Shift+q exec shutdown now
bindsym $mod+Shift+w exec reboot
bindsym $mod+Shift+e exit
bindsym $mod+Q kill

# ── appearance
gaps inner 20
gaps outer 0

client.focused          #fcc8b4 #fcc8b4 #fcc8b4 #fe902f #fcc8b4 
client.unfocused        #1e1715 #1e1715 #1e1715 #1e1715 #1e1715
client.focused_inactive #1e1715 #1e1715 #1e1715 #1e1715 #1e1715
client.urgent           #ff6600 #ff6600 #ff6600 #ff6600 #ff6600

for_window [class=".*"] border pixel 2
new_window pixel 2
new_float pixel 2

# ── window behavior
focus_follows_mouse yes
mouse_warping output
exec_always xrandr --output HDMI1 --rotate left --mode 1920x1080 --pos 0x0
exec_always xrandr --output eDP1  --mode 1920x1080 --pos 1080x840
exec_always --no-startup-id sh -c "picom --backend glx -b --config ~/.config/picom/picom.conf"

# ── startup
exec_always --no-startup-id gsettings set org.gnome.desktop.interface cursor-theme $cursor
exec_always --no-startup-id gsettings set org.gnome.desktop.interface cursor-size 20
exec --no-startup-id ~/.config/polybar/launch.sh
exec_always xset s off -dpms
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf
exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec_always systemctl --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
exec_always feh_cycle_wallpaper.py /home/cascade/Wallpaper/warm_train.png 200
exec_always --no-startup-id xsettingsd
exec_always pkill steam
exec_always --no-startup-id unclutter -idle 3
exec_always --no-startup-id eval $(gnome-keyring-daemon --start)
exec_always $terminal

# ── Keybindings: apps
bindsym $mod+Return exec $terminal
for_window [class="floater"] floating enable, resize set 980 590

bindsym $mod+N exec $fileManager
bindsym $mod+P exec $guifileManager
bindsym $mod+R exec $menu
bindsym $mod+X exec $browser
bindsym $mod+o exec --no-startup-id /usr/bin/tor-browser
bindsym $mod+T exec jellyfinmediaplayer

#"paru -Syyu --noconfirm"

bindsym Mod1+q exec blueberry
for_window [class="blueberry"] floating enable
bindsym Mod1+w exec gnome-calculator
for_window [class="gnome-calculator"] floating enable
bindsym Mod1+e exec pavucontrol
for_window [class="pavucontrol"] floating enable
bindsym Mod1+r exec maim -s ~/Pictures/Screenshots/screenshot_$(date +'%Y-%m-%d_%H-%M-%S').png
bindsym Mod1+t exec xpickcolour.sh
bindsym Mod1+a exec lxappearance

# ── Window movement
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+j focus down
bindsym $mod+k focus up

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+V floating toggle
bindsym $mod+B split toggle
bindsym $mod+G layout toggle split

bindsym $mod+a move position mouse
bindsym $mod+z mode "resize"
mode "resize" {
    bindsym h resize shrink width 5 px or 10 ppt
    bindsym k resize grow height 5 px or 10 ppt
    bindsym j resize shrink height 5 px or 10 ppt
    bindsym l resize grow width 5 px or 10 ppt
    bindsym $mod+z mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ── workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1; workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2; workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3; workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4; workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5; workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6; workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7; workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8; workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9; workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10; workspace $ws10

# scroll through workspaces
bindsym $mod+button4 workspace next
bindsym $mod+button5 workspace prev

# misc
focus_follows_mouse yes
workspace_auto_back_and_forth yes

